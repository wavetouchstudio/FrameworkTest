# Normalize line endings for all text files
* text=auto eol=lf

# C++ source
*.cpp  text eol=lf
*.h    text eol=lf
*.cs   text eol=lf diff=csharp

# Config and data files
*.ini  text eol=lf
*.json text eol=lf
*.xml  text eol=lf
*.txt  text eol=lf
*.md   text eol=lf

# Unreal project file
*.uproject text eol=lf

# UE binary asset formats — never diff or merge
*.uasset binary
*.umap   binary
*.ubulk  binary
*.uptnl  binary
